<local:FishstrapPage x:Class="FishstrapV2.Pages.AboutPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FishstrapV2.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,22,32,28">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Grid Height="64" MinWidth="300">
                    <Image x:Name="LogoDark" Source="/Assets/Bloxstrap-full-dark.png" Height="64"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <Image x:Name="LogoLight" Source="/Assets/Bloxstrap-full-light.png" Height="64"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                </Grid>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Fishstrap V2" FontSize="20" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="VersionText" Style="{StaticResource Mono}"
                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="12.5"/>
                        <TextBlock Text="  &#8226;  " Style="{StaticResource Mono}"
                                   Foreground="{DynamicResource BrushTextTertiary}" FontSize="12.5"/>
                        <TextBlock x:Name="ChannelText" Style="{StaticResource Mono}"
                                   Foreground="{DynamicResource BrushAccent}" FontSize="12.5"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" Style="{DynamicResource TextSecondary}" FontSize="12.5" MaxWidth="900"
                       HorizontalAlignment="Left" Margin="0,0,0,20"
                       Text="Fishstrap V2 is a custom bootstrapper for Roblox based on Fishstrap. It manages your Roblox installation, applies FastFlags and mods, and adds quality-of-life features on top of the official launcher."/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnCheckUpdates" Content="Check for updates" Style="{StaticResource PrimaryButton}"
                        Click="BtnCheckUpdates_Click"/>
                <Button x:Name="BtnGitHub" Content="GitHub repository" Style="{StaticResource CmdButton}"
                        Margin="10,0,0,0" Click="BtnGitHub_Click"/>
                <Button x:Name="BtnIssues" Content="Report an issue" Style="{StaticResource CmdButton}"
                        Margin="10,0,0,0" Click="BtnIssues_Click"/>
                <Button x:Name="BtnWebsite" Content="Website" Style="{StaticResource CmdButton}"
                        Margin="10,0,0,0" Click="BtnWebsite_Click"/>
                <Button x:Name="BtnOpenLogs" Content="Open logs folder" Style="{StaticResource GhostButton}"
                        Margin="10,0,0,0" Click="BtnOpenLogs_Click"/>
            </StackPanel>

            <TextBlock x:Name="UpdateStatus" Style="{DynamicResource TextSecondary}" FontSize="12.5"
                       Margin="0,12,0,0"/>

            <TextBlock Text="Licenses" Style="{StaticResource H2}" Margin="0,26,0,10"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Fishstrap V2 — MIT License" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock TextWrapping="Wrap" Style="{DynamicResource TextSecondary}" FontSize="12"
                               Margin="0,6,0,0"
                               Text="Copyright (c) 2026 Mikeykorby. Fishstrap V2 is a fork of Fishstrap (MIT, Copyright (c) 2025 returnrqt), which is based on Bloxstrap by pizzaboxer (MIT). This project builds on the ideas of both and is distributed under the MIT license."/>
                    <TextBlock TextWrapping="Wrap" Style="{DynamicResource TextTertiary}" FontSize="11.5"
                               Margin="0,8,0,0"
                               Text="Roblox is a trademark of Roblox Corporation. Fishstrap V2 is not affiliated with, endorsed by, or sponsored by Roblox Corporation."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:FishstrapPage>
