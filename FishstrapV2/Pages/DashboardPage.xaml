<local:FishstrapPage x:Class="FishstrapV2.Pages.DashboardPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FishstrapV2.UI"
        xmlns:ctrl="clr-namespace:FishstrapV2.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,34,32,28">

            <TextBlock Text="Dashboard" Style="{StaticResource H1}" Margin="0,0,0,20"/>

            <!-- Hero -->
            <Grid Margin="0,0,0,22">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Bloxstrap.png" Width="58" Height="58"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Fishstrap" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource AppFontBold}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="VersionText" Text="Version 3.0.4"
                                       Style="{StaticResource Mono}"
                                       Foreground="{DynamicResource BrushTextSecondary}" FontSize="12.5"/>
                            <TextBlock Text="  &#8226;  " Style="{StaticResource Mono}"
                                       Foreground="{DynamicResource BrushTextTertiary}" FontSize="12.5"/>
                            <TextBlock x:Name="ChannelLink" Text="production"
                                       Style="{StaticResource Mono}"
                                       Foreground="{DynamicResource BrushAccent}" FontSize="12.5"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="BtnRefresh" Style="{StaticResource IconButton}" Click="BtnRefresh_Click"
                            ToolTip="Refresh status">
                        <ctrl:IconGlyph Icon="refresh-cw" Size="14"/>
                    </Button>
                    <Button x:Name="BtnUpdate" Style="{StaticResource IconButton}" Click="BtnUpdate_Click"
                            ToolTip="Check for updates" Margin="4,0,0,0">
                        <ctrl:IconGlyph Icon="download" Size="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status cards -->
            <UniformGrid Columns="4">
                <ctrl:StatusCard x:Name="CardVersion" Icon="tag" Label="Roblox Version"
                                 IconTint="#33456E" Value="Checking&#8230;" Margin="0,0,12,0"/>
                <ctrl:StatusCard x:Name="CardChannel" Icon="globe" Label="Channel"
                                 IconTint="#4A3A70" Value="production" Margin="0,0,12,0"/>
                <ctrl:StatusCard x:Name="CardInstalled" Icon="hard-drive" Label="Installed"
                                 IconTint="#2E5C44" Value="Not installed" Margin="0,0,12,0"/>
                <ctrl:StatusCard x:Name="CardStatus" Icon="activity" Label="Status"
                                 IconTint="#6E3333" Value="Not installed"/>
            </UniformGrid>

            <!-- Quick launch -->
            <TextBlock Text="Quick Launch" Style="{StaticResource H2}" Margin="0,26,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ctrl:QuickLaunchButton x:Name="LaunchPlayer" Grid.Column="0" Icon="play"
                                        IconTint="#4C3F8F" Title="Launch Roblox Player"
                                        Subtitle="Play games with your custom setup"/>
                <ctrl:QuickLaunchButton x:Name="LaunchStudio" Grid.Column="2" Icon="hammer"
                                        IconTint="#3A5C74" Title="Launch Roblox Studio"
                                        Subtitle="Create and test your experiences"/>
            </Grid>

            <!-- Quick settings + quick links -->
            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Quick Settings" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                    <StackPanel>
                        <ctrl:SettingRow x:Name="RowActivity" Icon="activity" IconTint="#2E2E38"
                                         Title="Activity Tracking" Subtitle="Log sessions and playtime">
                            <ctrl:SettingRow.RowContent>
                                <CheckBox x:Name="ChkActivity" Style="{StaticResource ModernToggle}"
                                          Checked="QuickSetting_Changed" Unchecked="QuickSetting_Changed"/>
                            </ctrl:SettingRow.RowContent>
                        </ctrl:SettingRow>
                        <ctrl:SettingRow x:Name="RowRpc" Icon="message-circle" IconTint="#2E2E38"
                                         Title="Discord RPC" Subtitle="Show your game in Discord" Margin="0,10,0,0">
                            <ctrl:SettingRow.RowContent>
                                <CheckBox x:Name="ChkRpc" Style="{StaticResource ModernToggle}"
                                          Checked="QuickSetting_Changed" Unchecked="QuickSetting_Changed"/>
                            </ctrl:SettingRow.RowContent>
                        </ctrl:SettingRow>
                        <ctrl:SettingRow x:Name="RowFlags" Icon="flag" IconTint="#2E2E38"
                                         Title="Fast Flags" Subtitle="Apply custom engine flags" Margin="0,10,0,0">
                            <ctrl:SettingRow.RowContent>
                                <CheckBox x:Name="ChkFlags" Style="{StaticResource ModernToggle}"
                                          Checked="QuickSetting_Changed" Unchecked="QuickSetting_Changed"/>
                            </ctrl:SettingRow.RowContent>
                        </ctrl:SettingRow>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Quick Links" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                    <StackPanel>
                        <ctrl:SettingRow x:Name="LinkIntegrations" Icon="plug" IconTint="#2E2E38"
                                         Title="Integrations" Subtitle="Discord, activity tracking"
                                         IsClickable="True"/>
                        <ctrl:SettingRow x:Name="LinkMods" Icon="puzzle" IconTint="#2E2E38"
                                         Title="Mods" Subtitle="Cursors, sounds, custom font"
                                         IsClickable="True" Margin="0,10,0,0"/>
                        <ctrl:SettingRow x:Name="LinkFlags" Icon="flag" IconTint="#2E2E38"
                                         Title="Fast Flags" Subtitle="Performance and quality settings"
                                         IsClickable="True" Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Statistics -->
            <TextBlock Text="Statistics" Style="{StaticResource H2}" Margin="0,26,0,12"/>
            <UniformGrid Columns="3">
                <ctrl:StatusCard x:Name="StatLaunches" Icon="rocket" Label="Total launches"
                                 IconTint="#2E2E38" Value="0" Margin="0,0,12,0"/>
                <ctrl:StatusCard x:Name="StatPlaytime" Icon="clock" Label="Total playtime"
                                 IconTint="#2E2E38" Value="0s" Margin="0,0,12,0"/>
                <ctrl:StatusCard x:Name="StatWeek" Icon="calendar" Label="Last 7 days"
                                 IconTint="#2E2E38" Value="0 launches"/>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</local:FishstrapPage>
