<local:FishstrapPage x:Class="FishstrapV2.Pages.DeploymentPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FishstrapV2.UI"
        xmlns:ctrl="clr-namespace:FishstrapV2.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,22,32,28">

            <TextBlock Text="Deployment" Style="{StaticResource H1}" Margin="0,0,0,6"/>
            <TextBlock Text="Manage which Roblox version is installed and how it updates."
                       Style="{StaticResource TextSecondary}" Margin="0,0,0,22"/>

            <StackPanel>
                <ctrl:SettingRow x:Name="RowChannel" Icon="&#xE753;" IconTint="#4A3A70"
                                 Title="Channel" Subtitle="Roblox release channel to track">
                    <ctrl:SettingRow.RowContent>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="CmbChannel" Width="170" SelectionChanged="Channel_Changed">
                                <ComboBoxItem Content="production"/>
                                <ComboBoxItem Content="ZIntegration"/>
                                <ComboBoxItem Content="Custom&#8230;"/>
                            </ComboBox>
                            <TextBox x:Name="TxtCustomChannel" Width="140" Margin="10,0,0,0"
                                     Visibility="Collapsed" LostFocus="CustomChannel_LostFocus"
                                     ToolTip="Custom channel name"/>
                        </StackPanel>
                    </ctrl:SettingRow.RowContent>
                </ctrl:SettingRow>
                <ctrl:SettingRow x:Name="RowWait" Icon="&#xE823;" IconTint="#2E2E38"
                                 Title="Wait for latest version" Subtitle="Wait for the newest timestamped build before installing"
                                 Margin="0,10,0,0">
                    <ctrl:SettingRow.RowContent>
                        <CheckBox x:Name="ChkWait" Style="{StaticResource ModernToggle}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    </ctrl:SettingRow.RowContent>
                </ctrl:SettingRow>
                <ctrl:SettingRow x:Name="RowServer" Icon="&#xE946;" IconTint="#2E2E38"
                                 Title="Download location" Subtitle="Preferred CDN region for downloads" Margin="0,10,0,0">
                    <ctrl:SettingRow.RowContent>
                        <ComboBox x:Name="CmbServer" Width="220" SelectionChanged="Server_Changed">
                            <ComboBoxItem Content="Automatic"/>
                            <ComboBoxItem Content="AWS US East (N. Virginia)"/>
                            <ComboBoxItem Content="AWS EU (Ireland)"/>
                            <ComboBoxItem Content="AWS Asia Pacific (Tokyo)"/>
                        </ComboBox>
                    </ctrl:SettingRow.RowContent>
                </ctrl:SettingRow>
                <ctrl:SettingRow x:Name="RowKeep" Icon="&#xE787;" IconTint="#2E2E38"
                                 Title="Keep old versions" Subtitle="How many previous versions to keep on disk"
                                 Margin="0,10,0,0">
                    <ctrl:SettingRow.RowContent>
                        <ComboBox x:Name="CmbKeep" Width="110" SelectionChanged="Keep_Changed">
                            <ComboBoxItem Content="0"/>
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                        </ComboBox>
                    </ctrl:SettingRow.RowContent>
                </ctrl:SettingRow>
            </StackPanel>

            <!-- Actions -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnCheck" Content="Check for updates" Style="{StaticResource CmdButton}"
                            Click="BtnCheck_Click"/>
                    <Button x:Name="BtnReinstall" Content="Reinstall current version" Style="{StaticResource CmdButton}"
                            Margin="10,0,0,0" Click="BtnReinstall_Click"/>
                    <Button x:Name="BtnStudio" Content="Install Roblox Studio" Style="{StaticResource CmdButton}"
                            Margin="10,0,0,0" Click="BtnStudio_Click"/>
                    <Button x:Name="BtnUninstall" Content="Uninstall all" Style="{StaticResource DangerButton}"
                            Margin="10,0,0,0" Click="BtnUninstall_Click"/>
                </StackPanel>
            </Border>

            <!-- Version history -->
            <TextBlock Text="Version history" Style="{StaticResource H2}" Margin="0,24,0,12"/>
            <Border Style="{StaticResource Card}" Padding="6">
                <StackPanel>
                    <Grid Margin="10,6,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Version hash" Style="{DynamicResource TextSecondary}" FontSize="11.5"/>
                        <TextBlock Grid.Column="1" Text="Channel" Style="{DynamicResource TextSecondary}" FontSize="11.5"/>
                        <TextBlock Grid.Column="2" Text="Installed" Style="{DynamicResource TextSecondary}" FontSize="11.5"/>
                        <TextBlock Grid.Column="3" Text="Size" Style="{DynamicResource TextSecondary}" FontSize="11.5"/>
                    </Grid>
                    <ItemsControl x:Name="VersionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,4,10,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Hash}" Style="{StaticResource Mono}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource Chip}" HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Channel}" FontSize="10.5"
                                                   Foreground="{DynamicResource BrushInfo}"
                                                   FontFamily="{StaticResource MonoFont}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding InstalledText}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Mono}"
                                               FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Click="BtnOpen_Click" ToolTip="Open folder"
                                                Tag="{Binding}">
                                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Click="BtnPin_Click" ToolTip="Pin version"
                                                Tag="{Binding}">
                                            <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Click="BtnDelete_Click" ToolTip="Delete version"
                                                Tag="{Binding}">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoVersions" Text="No versions installed yet — press Check for updates."
                               Style="{DynamicResource TextSecondary}" FontSize="12.5" Margin="10,6,0,8"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ProgressText" Style="{StaticResource TextSecondary}" FontSize="12"/>
                <ProgressBar x:Name="Progress" IsIndeterminate="True" Margin="0,8,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:FishstrapPage>
