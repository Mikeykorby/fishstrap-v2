<local:FishstrapPage x:Class="FishstrapV2.Pages.AppearancePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FishstrapV2.UI"
        xmlns:ctrl="clr-namespace:FishstrapV2.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,34,32,28">

            <TextBlock Text="Appearance" Style="{StaticResource H1}" Margin="0,0,0,6"/>
            <TextBlock Text="Make Fishstrap V2 look the way you like it."
                       Style="{StaticResource TextSecondary}" Margin="0,0,0,22"/>

            <ctrl:SettingRow x:Name="RowTheme" Icon="sun-moon" IconTint="{DynamicResource BrushTextSecondary}"
                             Title="Theme" Subtitle="Dark, light or follow Windows">
                <ctrl:SettingRow.RowContent>
                    <ComboBox x:Name="CmbTheme" Width="140" SelectionChanged="Theme_Changed">
                        <ComboBoxItem Content="Dark"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="System"/>
                    </ComboBox>
                </ctrl:SettingRow.RowContent>
            </ctrl:SettingRow>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Accent color" FontWeight="SemiBold" FontFamily="{StaticResource AppFontSemiBold}" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource IconButton}" Tag="#7C6CF0" Click="Swatch_Click" ToolTip="Indigo">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#7C6CF0"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Tag="#5B8DEF" Click="Swatch_Click" ToolTip="Blue" Margin="6,0,0,0">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#5B8DEF"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Tag="#34D399" Click="Swatch_Click" ToolTip="Green" Margin="6,0,0,0">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#34D399"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Tag="#F59E0B" Click="Swatch_Click" ToolTip="Amber" Margin="6,0,0,0">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#F59E0B"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Tag="#F472B6" Click="Swatch_Click" ToolTip="Pink" Margin="6,0,0,0">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#F472B6"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Tag="#EF4444" Click="Swatch_Click" ToolTip="Red" Margin="6,0,0,0">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#EF4444"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Tag="#22C55E" Click="Swatch_Click" ToolTip="Emerald" Margin="6,0,0,0">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#22C55E"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Tag="#94A3B8" Click="Swatch_Click" ToolTip="Slate" Margin="6,0,0,0">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#94A3B8"/>
                        </Button>
                        <TextBox x:Name="TxtAccentHex" Width="110" Margin="14,0,0,0"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                 ToolTip="Custom hex color like #7C6CF0"/>
                        <Button Content="Apply" Style="{StaticResource CmdButton}" Margin="10,0,0,0"
                                Click="BtnAccentApply_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Custom app icon" FontWeight="SemiBold" FontFamily="{StaticResource AppFontSemiBold}" FontSize="13"/>
                    <TextBlock Text="Shown next to the Fishstrap name on the dashboard."
                               Style="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,2,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="12" x:Name="IconPreview"
                                Background="{DynamicResource BrushAccent}" ClipToBounds="True">
                            <Image x:Name="IconImage" Stretch="UniformToFill"/>
                        </Border>
                        <Button Content="Choose image&#8230;" Style="{StaticResource CmdButton}" Margin="14,0,0,0"
                                Click="BtnIconPick_Click"/>
                        <Button Content="Reset" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                Click="BtnIconReset_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Bootstrapper -->
            <TextBlock Text="Bootstrapper" Style="{StaticResource H2}" Margin="0,24,0,4"/>
            <TextBlock Text="How the install progress window looks while Roblox installs or updates."
                       Style="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource Card}" HorizontalAlignment="Stretch">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Bootstrapper style" FontSize="12.5" FontWeight="SemiBold"
                                       FontFamily="{StaticResource AppFontSemiBold}"/>
                            <TextBlock Text="Choose the dialog style. Bloxnified themes are built in."
                                       Style="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="CmbBootstrapperStyle" Grid.Column="1" Width="170" Margin="0,0,10,0"
                                  SelectionChanged="BootstrapperStyle_Changed"/>
                        <Button x:Name="BtnPreviewBootstrapper" Grid.Column="2" Content="Preview"
                                Style="{StaticResource CmdButton}" Click="BtnPreviewBootstrapper_Click"/>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Logo animation" FontSize="12.5" FontWeight="SemiBold"
                                       FontFamily="{StaticResource AppFontSemiBold}"/>
                            <TextBlock Text="Static, spinning, or a custom image — animated GIFs play."
                                       Style="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ComboBox x:Name="CmbBootstrapperAnimation" Width="120" SelectionChanged="BootstrapperAnimation_Changed">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Spin"/>
                                <ComboBoxItem Content="Custom"/>
                            </ComboBox>
                            <Button x:Name="BtnPickLogo" Content="Pick file&#8230;" Style="{StaticResource CmdButton}"
                                    Margin="10,0,0,0" Visibility="Collapsed" Click="BtnPickLogo_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Bootstrapper title" FontSize="12.5" FontWeight="SemiBold"
                                       FontFamily="{StaticResource AppFontSemiBold}"/>
                            <TextBlock Text="Shown in the install window's title bar."
                                       Style="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="TxtBootstrapperTitle" Grid.Column="1" Width="200"
                                 LostFocus="BootstrapperTitle_LostFocus"/>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Custom themes" FontSize="12.5" FontWeight="SemiBold"
                                       FontFamily="{StaticResource AppFontSemiBold}"/>
                            <TextBlock Text="Import any Bloxstrap-style theme folder (Theme.xml plus its assets)."
                                       Style="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnImportTheme" Grid.Column="1" Content="Import&#8230;"
                                Style="{StaticResource CmdButton}" Click="BtnImportTheme_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:FishstrapPage>
