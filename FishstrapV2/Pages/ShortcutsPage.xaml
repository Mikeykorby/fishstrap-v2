<local:FishstrapPage x:Class="FishstrapV2.Pages.ShortcutsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FishstrapV2.UI"
        xmlns:ctrl="clr-namespace:FishstrapV2.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,22,32,28">

            <TextBlock Text="Shortcuts" Style="{StaticResource H1}" Margin="0,0,0,6"/>
            <TextBlock Text="Decide which shortcuts Fishstrap V2 creates on your system."
                       Style="{StaticResource TextSecondary}" Margin="0,0,0,22"/>

            <StackPanel>
                <ctrl:SettingRow x:Name="RowDesktop" Icon="monitor" IconTint="#33456E"
                                 Title="Desktop shortcut" Subtitle="Create a shortcut on your desktop">
                    <ctrl:SettingRow.RowContent>
                        <CheckBox x:Name="ChkDesktop" Style="{StaticResource ModernToggle}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    </ctrl:SettingRow.RowContent>
                </ctrl:SettingRow>
                <ctrl:SettingRow x:Name="RowStartMenu" Icon="app-window" IconTint="#2E5C44"
                                 Title="Start menu shortcut" Subtitle="Create a shortcut in the Start menu"
                                 Margin="0,10,0,0">
                    <ctrl:SettingRow.RowContent>
                        <CheckBox x:Name="ChkStartMenu" Style="{StaticResource ModernToggle}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    </ctrl:SettingRow.RowContent>
                </ctrl:SettingRow>
                <ctrl:SettingRow x:Name="RowOnInstall" Icon="circle-check" IconTint="#4A3A70"
                                 Title="Create on install" Subtitle="Create shortcuts automatically when Roblox installs"
                                 Margin="0,10,0,0">
                    <ctrl:SettingRow.RowContent>
                        <CheckBox x:Name="ChkOnInstall" Style="{StaticResource ModernToggle}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    </ctrl:SettingRow.RowContent>
                </ctrl:SettingRow>
                <ctrl:SettingRow x:Name="RowSettings" Icon="settings" IconTint="#2E2E38"
                                 Title="Extra: settings shortcut" Subtitle="A desktop shortcut that opens Fishstrap V2 settings"
                                 Margin="0,10,0,0">
                    <ctrl:SettingRow.RowContent>
                        <CheckBox x:Name="ChkSettings" Style="{StaticResource ModernToggle}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    </ctrl:SettingRow.RowContent>
                </ctrl:SettingRow>
                <ctrl:SettingRow x:Name="RowLastGame" Icon="gamepad-2" IconTint="#2E2E38"
                                 Title="Extra: last game shortcut" Subtitle="A desktop shortcut that opens the last game you played"
                                 Margin="0,10,0,0">
                    <ctrl:SettingRow.RowContent>
                        <CheckBox x:Name="ChkLastGame" Style="{StaticResource ModernToggle}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    </ctrl:SettingRow.RowContent>
                </ctrl:SettingRow>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Create shortcuts now" Style="{StaticResource PrimaryButton}"
                                Click="BtnCreate_Click"/>
                        <Button Content="Remove all shortcuts" Style="{StaticResource DangerButton}"
                                Margin="10,0,0,0" Click="BtnRemove_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ExistingInfo" Style="{DynamicResource TextSecondary}" FontSize="12" Margin="0,12,0,0"/>
                    <TextBlock Style="{DynamicResource TextTertiary}" FontSize="11.5" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="Shortcuts are created with the Windows shell (WScript.Shell), pointing at the Fishstrap V2 executable."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:FishstrapPage>
