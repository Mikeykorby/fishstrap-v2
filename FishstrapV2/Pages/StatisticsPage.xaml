<local:FishstrapPage x:Class="FishstrapV2.Pages.StatisticsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FishstrapV2.UI"
        xmlns:ctrl="clr-namespace:FishstrapV2.UI.Controls">
    <local:FishstrapPage.Resources>
        <DataTemplate x:Key="ChartDayTemplate">
            <Grid Height="110" Margin="3,0,3,0">
                <StackPanel VerticalAlignment="Bottom">
                    <Border Background="{DynamicResource BrushAccent}" CornerRadius="4,4,0,0"
                            Height="{Binding BarHeight}" Opacity="0.9"/>
                </StackPanel>
                <TextBlock Text="{Binding Count}" FontSize="9" Style="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SessionTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StartText}" FontSize="12" FontFamily="{StaticResource MonoFont}"
                           Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Style="{StaticResource Chip}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Binary}" FontSize="10.5" FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource BrushInfo}"/>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource AppFontSemiBold}"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </local:FishstrapPage.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,34,32,28">

            <Grid>
                <TextBlock Text="Statistics" Style="{StaticResource H1}"/>
                <Button x:Name="BtnClearStats" Content="Clear statistics" Style="{StaticResource DangerButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnClearStats_Click"/>
            </Grid>
            <TextBlock Text="Recorded while activity tracking is enabled."
                       Style="{StaticResource TextSecondary}" Margin="0,6,0,22"/>

            <UniformGrid Columns="3">
                <ctrl:StatusCard x:Name="CardLaunches" Icon="rocket" Label="Total launches"
                                 IconTint="{DynamicResource BrushTextSecondary}" Value="0" Margin="0,0,12,0"/>
                <ctrl:StatusCard x:Name="CardPlaytime" Icon="clock" Label="Total playtime"
                                 IconTint="{DynamicResource BrushTextSecondary}" Value="0s" Margin="0,0,12,0"/>
                <ctrl:StatusCard x:Name="CardAverage" Icon="rotate-ccw" Label="Average session"
                                 IconTint="{DynamicResource BrushTextSecondary}" Value="0s"/>
            </UniformGrid>

            <StackPanel x:Name="SessionPanel" Visibility="Collapsed">
                <TextBlock Text="Current session" Style="{StaticResource H2}" Margin="0,24,0,12"/>
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Game" Style="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock x:Name="TxtSessionGame" Grid.Column="1" FontWeight="SemiBold" FontSize="12.5"
                                   FontFamily="{StaticResource AppFontSemiBold}" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="1" Text="Server location" Style="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock x:Name="TxtSessionLocation" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" FontSize="12.5"
                                   FontFamily="{StaticResource AppFontSemiBold}" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="2" Text="Instance ID" Style="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock x:Name="TxtSessionInstance" Grid.Row="2" Grid.Column="1" FontSize="12"
                                   FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="3" Text="Uptime" Style="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock x:Name="TxtSessionUptime" Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" FontSize="12.5"
                                   FontFamily="{StaticResource AppFontSemiBold}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Text="Launches — last 14 days" Style="{StaticResource H2}" Margin="0,24,0,12"/>
            <Border Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <ItemsControl x:Name="Chart" ItemTemplate="{StaticResource ChartDayTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="14"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl x:Name="ChartLabels">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="14"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="9" Style="{DynamicResource TextTertiary}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="Session history" Style="{StaticResource H2}" Margin="0,24,0,12"/>
            <Border Style="{StaticResource Card}" Padding="16,12">
                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="SessionList" ItemTemplate="{StaticResource SessionTemplate}"/>
                        <TextBlock x:Name="NoSessions" Text="No sessions recorded yet — launch Roblox with activity tracking on."
                                   Style="{DynamicResource TextSecondary}" FontSize="12.5" Margin="0,6,0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:FishstrapPage>
