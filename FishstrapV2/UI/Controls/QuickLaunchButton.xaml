<UserControl x:Class="FishstrapV2.UI.Controls.QuickLaunchButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:FishstrapV2.UI.Controls">
    <Border x:Name="Root" Background="{DynamicResource BrushCard}"
            BorderBrush="{DynamicResource BrushCardBorder}"
            BorderThickness="1" CornerRadius="12" Padding="16,14" Cursor="Hand"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale"/>
        </Border.RenderTransform>
        <Grid>
            <Border x:Name="HoverLayer" Background="{DynamicResource BrushCardHover}" CornerRadius="11" Opacity="0"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ctrl:IconGlyph Icon="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Size="20" Foreground="{Binding IconTint, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,13,0">
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                </StackPanel>
                <ctrl:IconGlyph Grid.Column="2" Icon="chevron-right" Size="12"
                           Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
