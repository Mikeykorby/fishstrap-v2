<UserControl x:Class="FishstrapV2.UI.Controls.StatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BrushCard}"
            BorderBrush="{DynamicResource BrushCardBorder}"
            BorderThickness="1" CornerRadius="12" Padding="14">
        <StackPanel>
            <Border Width="30" Height="30" CornerRadius="8" Background="{Binding IconTint, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock Text="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="#E6E6F0" Opacity="0.85"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,10,0,0"/>
            <TextBlock x:Name="ValueText"
                       Style="{DynamicResource Mono}" FontSize="14.5" FontWeight="SemiBold"
                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{Binding ValueBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </StackPanel>
    </Border>
</UserControl>
