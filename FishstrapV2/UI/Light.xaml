<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme brush overrides (loaded over Theme.xaml when enabled) -->
    <SolidColorBrush x:Key="BrushBg" Color="#F2F2F6"/>
    <SolidColorBrush x:Key="BrushBgAlt" Color="#E9E9EF"/>
    <SolidColorBrush x:Key="BrushSidebar" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushCardHover" Color="#F4F4F8"/>
    <SolidColorBrush x:Key="BrushCardBorder" Color="#E2E2EA"/>
    <SolidColorBrush x:Key="BrushField" Color="#F5F5F8"/>
    <SolidColorBrush x:Key="BrushFieldBorder" Color="#D8D8E2"/>
    <SolidColorBrush x:Key="BrushFieldFocus" Color="#B9B9C9"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#17171C"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#5B5B68"/>
    <SolidColorBrush x:Key="BrushTextTertiary" Color="#8A8A96"/>
    <SolidColorBrush x:Key="BrushDivider" Color="#E8E8EE"/>
    <SolidColorBrush x:Key="BrushPopup" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushPopupItemHover" Color="#F0F0F5"/>
    <SolidColorBrush x:Key="BrushNavHover" Color="#F2F2F6"/>
    <SolidColorBrush x:Key="BrushNavActive" Color="#EDEBFB"/>
    <SolidColorBrush x:Key="BrushNavActiveBorder" Color="#D8D3F5"/>
    <SolidColorBrush x:Key="BrushButton" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushButtonBorder" Color="#DCDCE6"/>
    <SolidColorBrush x:Key="BrushButtonHover" Color="#F4F4F8"/>
    <SolidColorBrush x:Key="BrushButtonPressed" Color="#E9E9EF"/>
    <SolidColorBrush x:Key="BrushScrollbar" Color="#C9C9D6"/>
    <SolidColorBrush x:Key="BrushTitleBtnHover" Color="#E4E4EC"/>
    <SolidColorBrush x:Key="BrushToggleOff" Color="#D8D8E2"/>
    <SolidColorBrush x:Key="BrushChip" Color="#EFEFF4"/>
</ResourceDictionary>
