<Window x:Class="FishstrapV2.UI.BootstrapperDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Fishstrap V2"
        Width="500" Height="280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None"
        ShowInTaskbar="True" Background="#1B1B1F"
        Closing="Window_Closing">
    <Grid x:Name="RootPanel">
        <StackPanel x:Name="DefaultPanel" VerticalAlignment="Center" Margin="32,0,32,16">
            <!-- Static tilted logo, like Bloxstrap's bootstrapper -->
            <Image x:Name="Logo" Width="80" Height="80" Margin="0,0,0,24"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="/Assets/Bloxstrap.png"/>

            <TextBlock x:Name="Message" Text="Please wait..." FontSize="18"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,0,0,16"/>

            <ProgressBar x:Name="Progress" Height="6" IsIndeterminate="True" Margin="0,0,0,18"/>

            <Button x:Name="BtnCancel" Content="Cancel" Width="120" FontSize="13"
                    Style="{StaticResource CmdButton}" HorizontalAlignment="Center"
                    IsEnabled="False" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
